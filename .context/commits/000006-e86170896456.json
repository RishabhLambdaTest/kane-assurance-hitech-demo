a7f","slug":"ac-15","by":{"kind":"ai","id":"design-agent"}},{"cid":"sha256:8c2ab40f8ade697e173b187fd6145a6548bcf3e74c369fdfdce01ef3bb2f5101","slug":"ac-16","by":{"kind":"ai","id":"design-agent"}}],"judgements":[{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 changes configuration options and the PRD states the running unit price updates immediately as options change.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 inspects and uses processor options on a valid workstation configuration.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 inspects and uses memory options on a valid workstation configuration.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 inspects and uses storage options, including the workstation-only 4 TB option.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 inspects and varies operating-system selections on the workstation path.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 stays within valid processor-memory combinations and does not trigger a downgrade from 64 GB memory.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 does not trigger the downgrade warning path.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 uses a workstation product, while this invariant is specific to laptop products.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 is designed as a fully valid configuration path and does not exercise an incompatible state.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 does not encounter an incompatible option that needs a visible reason.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-1 does not rely on incompatible options being displayed.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 uses the lower valid quantity boundary of 1.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-1 uses the upper valid quantity boundary of 500.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 changes options and should still observe the running unit price refresh bound.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 inspects and downgrades processor options.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 inspects and auto-corrects memory options.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 inspects the storage selector to prove the 4 TB option remains visible on laptops.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-2 does not inspect or vary operating-system choices and no oracle in this path depends on them.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 is centered on the processor downgrade from a 64 GB configuration.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 observes the exact warning text after the downgrade correction.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 uses a laptop product and directly checks the disabled 4 TB storage option.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 encounters incompatible choices that should appear disabled.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 checks the visibility of incompatibility reasons on the laptop-only and post-downgrade states.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Applicable because sc-2 proves the incompatible choices remain present rather than hidden.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-2 does not enter a quantity or attempt add-to-quote.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","rationale":"[applicability] Not applicable because sc-2 does not enter a quantity or attempt add-to-quote.","by":{"kind":"ai","id":"design-agent"}}],"design_of":{"uc_cid":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","engine":"design@1"},"event_ids":["design-20260914T111805-12ff:design:3"],"sid":"design-20260914T111805-12ff","design_phase":{"uc_root":"sha256:b63e6e9187b3c22d3003f54bd7fed0fc46d2f42cf44c6a67e7e2622550c21478","generation":1,"phase":"wiring","completeness":"complete"},"schema_version":"assurance/context@1","parents":["sha256:8f22db298ee445d87ecd7cd48312e71a050966dd6239da0d9fc6be2cce25f7d8"]}
